<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force HTTPS. Without this, plain http:// requests were served the full
    # site directly (200, no redirect) - session cookies issued over that
    # unencrypted connection lose their "Secure" flag (sniffable on a public
    # network), and it splits ranking/indexing signal between the http and
    # https versions of every page instead of consolidating on the https
    # canonical URLs the app already emits. X-Forwarded-Proto check covers
    # the case where SSL is terminated upstream of this server.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    # Deliberately does NOT exclude directories (no "!-d" check) - none of
    # this app's routes serve a folder's contents, so any request matching
    # an existing directory (assets/, dependencies/, media/, vendor/, etc.)
    # with no matching file should still reach Laravel and get the app's
    # own branded 404 page, instead of Apache handling it directly (which,
    # combined with Options -Indexes above, would otherwise mean a bare
    # 403 Forbidden with no matching route ever being consulted).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Security headers. HSTS/X-XSS-Protection/X-Content-Type-Options are already
# added by the hosting layer (confirmed via curl -I) - only the two below
# were actually missing. Skipping Content-Security-Policy here: the site
# loads Google Fonts, Google Analytics, and Google Maps embeds from several
# external hosts, and a wrong CSP silently breaks those instead of failing
# loudly - not something to hand-roll without testing each of them.
<IfModule mod_headers.c>
    # Blocks clickjacking - stops this site from being embedded in an
    # <iframe> on another domain. SAMEORIGIN (not DENY) since nothing here
    # needs to embed itself, but this also isn't an API that should never
    # be framed by anything.
    Header always set X-Frame-Options "SAMEORIGIN"
    # Strips the full URL (including query strings) from the Referer header
    # sent to OTHER sites when a visitor clicks an outbound link - avoids
    # leaking things like a password-reset token embedded in the current
    # page's URL to whatever site they click through to next.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compress text-based responses (CSS/JS/HTML/SVG/fonts) - safe to enable
# unconditionally, no staleness risk since it doesn't affect caching.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# Browser caching. Images/fonts get a long cache since uploads/vendor fonts
# rarely change in place. CSS/JS get a short cache (1 week) instead of the
# usual "1 year" advice - most of this theme's CSS (app.css, blog-modern.css,
# modern-home.css, etc.) is served WITHOUT a cache-busting query string, and
# this project's own edit history shows it gets hand-edited directly, so a
# long cache here would hide real changes from returning visitors.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
