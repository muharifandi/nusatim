<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Styles (Material 3 Scale) -->
    <style name="PartnerTypography.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/partner_on_surface</item>
    </style>

    <style name="PartnerTypography.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/partner_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PartnerTypography.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/partner_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PartnerTypography.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/partner_on_surface</item>
    </style>

    <style name="PartnerTypography.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/partner_on_surface_variant</item>
    </style>

    <!-- Component Styles -->
    <style name="PartnerButton.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/partner_primary</item>
        <item name="android:textColor">@color/partner_on_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Partner.Pill</item>
    </style>

    <style name="PartnerTextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/partner_primary</item>
        <item name="hintTextColor">@color/partner_primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/partner_radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/partner_radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/partner_radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/partner_radius_m</item>
    </style>

    <style name="PartnerCardFlat">
        <item name="android:background">@drawable/bg_card_flat</item>
    </style>

    <style name="PartnerBadge" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Partner.Pill</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.Partner.Pill" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
