<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_snackbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_snackbar"
    android:padding="@dimen/partner_radius_m">

    <View
        android:id="@+id/view_accent"
        android:layout_width="@dimen/partner_space_xs"
        android:layout_height="0dp"
        android:background="@color/status_info"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_icon"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/partner_icon_xl"
        android:layout_height="@dimen/partner_icon_xl"
        android:background="@drawable/bg_circle_orange_light"
        android:padding="6dp"
        android:src="@android:drawable/ic_dialog_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/status_info"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/partner_radius_m"
        android:layout_marginEnd="@dimen/partner_space_s"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_icon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/partner_black"
            android:textSize="@dimen/partner_text_body2"
            android:textStyle="bold"
            tools:text="Berhasil" />

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/partner_on_surface_variant"
            android:textSize="@dimen/partner_text_label1"
            tools:text="Pesan snackbar disini dengan detail yang lebih lengkap." />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
