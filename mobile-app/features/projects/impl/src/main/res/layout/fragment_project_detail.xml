<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/partner_surface">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/partner_surface">

                <include
                android:id="@+id/layout_toolbar"
                layout="@layout/layout_partner_toolbar" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/partner_space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_flat"
                    android:orientation="vertical"
                    android:padding="@dimen/partner_space_l">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_status"
                            style="@style/PartnerBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:enabled="false"
                            tools:text="Available" />

                        <TextView
                            android:id="@+id/tv_name"
                            style="@style/PartnerTypography.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/partner_space_s"
                            tools:text="Website Company Profile PT Maju" />

                        <TextView
                            android:id="@+id/tv_description"
                            style="@style/PartnerTypography.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/partner_space_m"
                            android:textColor="@color/partner_on_surface_variant"
                            tools:text="Pembuatan website 5 halaman + hosting 1 tahun." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/partner_divider_height"
                            android:layout_marginVertical="@dimen/partner_space_l"
                            android:background="@color/partner_silver" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical">
                                <TextView style="@style/PartnerTypography.Label" android:text="@string/project_label_budget" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                                <TextView android:id="@+id/tv_budget" style="@style/PartnerTypography.Title" android:textColor="@color/partner_primary" tools:text="Rp20jt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="vertical">
                                <TextView style="@style/PartnerTypography.Label" android:text="@string/project_label_commission" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                                <TextView android:id="@+id/tv_commission" style="@style/PartnerTypography.Title" android:textColor="@color/status_success" tools:text="Rp2jt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginTop="@dimen/partner_space_m"
                                android:orientation="vertical">
                                <TextView style="@style/PartnerTypography.Label" android:text="@string/project_label_location" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                                <TextView android:id="@+id/tv_location" style="@style/PartnerTypography.Body" tools:text="Jakarta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginTop="@dimen/partner_space_m"
                                android:orientation="vertical">
                                <TextView style="@style/PartnerTypography.Label" android:text="@string/project_label_deadline" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                                <TextView android:id="@+id/tv_deadline" style="@style/PartnerTypography.Body" tools:text="30 Sept 2026" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>
                        </GridLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action"
                    style="@style/PartnerButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/partner_space_xl"
                    android:text="@string/project_btn_claim_long" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
