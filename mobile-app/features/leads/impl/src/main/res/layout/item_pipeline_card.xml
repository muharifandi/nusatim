<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_flat"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Profile Section -->
        <FrameLayout
            android:id="@+id/card_profile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_orange_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_partner_logo"
                app:tint="@color/partner_primary"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name"
            style="@style/PartnerTypography.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="16sp"
            android:textColor="@color/partner_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_profile"
            app:layout_constraintTop_toTopOf="@id/card_profile"
            app:layout_constraintBottom_toTopOf="@id/tv_phone"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Budi Santoso" />

        <TextView
            android:id="@+id/tv_phone"
            style="@style/PartnerTypography.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/card_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="081234567001" />

        <!-- Dashed Divider -->
        <View
            android:id="@+id/divider_dashed"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/divider_dashed"
            android:alpha="0.2"
            app:layout_constraintTop_toBottomOf="@id/card_profile" />

        <!-- Amount Section -->
        <LinearLayout
            android:id="@+id/card_wallet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/partner_button_primary_bg"
            android:backgroundTint="@color/project_orange_light"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_dashed">

            <ImageView
                android:id="@+id/iv_wallet"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wallet_small"
                app:tint="@color/partner_primary"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_estimation"
            style="@style/PartnerTypography.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/partner_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            app:layout_constraintBottom_toBottomOf="@id/card_wallet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_wallet"
            app:layout_constraintTop_toTopOf="@id/card_wallet"
            tools:text="Rp12.000.000" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
