<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/partner_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/partner_space_m">

            <!-- Customer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_flat"
                android:orientation="vertical"
                android:padding="@dimen/partner_space_m">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_payment_status"
                        style="@style/PartnerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:enabled="false"
                        tools:text="Belum Bayar" />

                    <TextView
                        android:id="@+id/tv_name"
                        style="@style/PartnerTypography.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_s"
                        tools:text="Budi Santoso" />

                    <TextView
                        android:id="@+id/tv_pic"
                        style="@style/PartnerTypography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_s"
                        tools:text="PIC: Budi (081234567890)" />

                    <TextView
                        android:id="@+id/tv_product"
                        style="@style/PartnerTypography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_xs"
                        android:textColor="@color/partner_primary"
                        tools:text="Sistem Panel Surya 5kWp" />

                    <TextView
                        android:id="@+id/tv_project_value"
                        style="@style/PartnerTypography.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_s"
                        tools:text="Rp50.000.000" />
            </LinearLayout>

            <!-- Project Card -->
            <LinearLayout
                android:id="@+id/card_project"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/partner_space_m"
                android:background="@drawable/bg_card_flat"
                android:orientation="vertical"
                android:padding="@dimen/partner_space_m"
                android:visibility="gone"
                tools:visibility="visible">

                    <TextView
                        style="@style/PartnerTypography.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/customer_label_progress" />

                    <TextView
                        android:id="@+id/tv_project_name"
                        style="@style/PartnerTypography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_xs"
                        tools:text="Website Company Profile PT Maju" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_project"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_m"
                        app:trackCornerRadius="@dimen/partner_space_xs"
                        app:trackThickness="@dimen/partner_space_s"
                        tools:progress="60" />

                    <TextView
                        android:id="@+id/tv_progress_label"
                        style="@style/PartnerTypography.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_s"
                        tools:text="60% Selesai" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_update_progress"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_m"
                        android:text="@string/customer_btn_update_progress" />
            </LinearLayout>

            <!-- Commission Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_commission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/partner_space_m"
                android:background="@drawable/bg_card_flat"
                android:padding="@dimen/partner_space_m"
                android:visibility="gone"
                tools:visibility="visible">

                    <TextView
                        android:id="@+id/label_commission"
                        style="@style/PartnerTypography.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/customer_label_commission"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_commission_amount"
                        style="@style/PartnerTypography.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/partner_space_xs"
                        android:textColor="@color/status_success"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/label_commission"
                        tools:text="Rp1.500.000" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_commission"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/customer_btn_view_detail"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
