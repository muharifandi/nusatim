<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/partner_agreement_height"
            android:background="@drawable/bg_card_flat"
            android:backgroundTint="@color/partner_surface_variant">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/partner_space_m">

                <TextView
                    android:id="@+id/tv_agreement_text"
                    style="@style/PartnerTypography.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/register_step_4_agreement" />
            </ScrollView>
        </FrameLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/partner_space_m"
            android:text="@string/register_step_4_check" />

    </LinearLayout>
</layout>
